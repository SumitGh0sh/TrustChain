# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/trustchain

# Security & JWT
JWT_SECRET=trustchain_jwt_secret_dev_2026_secure_key
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client / Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Blockchain Relayer Configuration
RPC_URL=http://127.0.0.1:8545
# Hardhat Account #1 Private Key (Pre-configured as RELAYER_ROLE in contracts)
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEPLOYMENTS_FILE_PATH=../contracts-project/deployments/localhost.json
ABI_DIR_PATH=../contracts-project/abi

# Business & Pricing (INR Based Credits)
INR_COST_PER_UNIT=1
INR_COST_PER_UNIT_STANDARD=1
INR_COST_PER_UNIT_HIGH_VALUE=2
POINTS_PER_CLAIM=50

# Mock OTP
MOCK_OTP_CODE=123456

# Clone Detection Config
CLONE_SCAN_THRESHOLD=50
CLONE_WINDOW_MINUTES=5


# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
